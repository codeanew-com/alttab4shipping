# Copy this file to .dev.vars and fill in the values.
# .dev.vars is git-ignored, so never commit the real key.
#
# Local testing:   npx wrangler pages dev public
# Upload to Cloudflare as secrets:
#   npx wrangler pages secret bulk .dev.vars --project-name alttab4shipping

# Resend API key with "Sending access" for alttab4shipping.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Inbox that receives quote requests
QUOTE_TO=you@gmail.com

# Sender shown on the email (must be on the verified Resend domain)
QUOTE_FROM=Alttab Website <website@alttab4shipping.com>
